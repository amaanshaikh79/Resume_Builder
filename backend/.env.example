# Application
APP_ENV=development
APP_NAME=AI Resume Builder
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_resume_builder
# For local development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ai_resume_builder.db

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (openai, gemini, ollama)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-flash
# For OpenAI: gpt-4o-mini or gpt-4
# For Gemini: gemini-1.5-flash or gemini-1.5-pro

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,txt

# SMTP (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@airesume.com
SMTP_FROM_NAME=AI Resume Builder

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
